<script>
function payNow() {

    const playerId = document.getElementById("playerId").value.trim();

    if (!playerId) {
        alert("Please enter your Player ID.");
        return;
    }

    const note =
        "UC Order | " +
        selectedPackage +
        " | Player ID: " +
        playerId;

    const upiUrl =
        "upi://pay" +
        "?pa=" + encodeURIComponent("meena556@fam") +
        "&pn=" + encodeURIComponent("UniTopUp") +
        "&am=" + encodeURIComponent(selectedPrice) +
        "&cu=INR" +
        "&tn=" + encodeURIComponent(note);

    // Android UPI chooser
    window.location.href = upiUrl;

    document
        .getElementById("afterPayment")
        .classList.add("show");
}
</script>
